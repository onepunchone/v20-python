class PositionManager:
    """Advanced position management with dynamic adjustments."""
    
    def __init__(self, logger: EliteLogger):
        self.logger = logger
        self.active_positions = {}
        self.position_lock = threading.Lock()
        
    def manage_positions(self) -> None:
        """Manage all active positions."""
        with self.position_lock:
            try:
                positions = mt5.positions_get()
                if not positions:
                    return
                
                for position in positions:
                    self._manage_single_position(position)
                    
            except Exception as e:
                self.logger.error(f"Position management failed: {e}")
    
    def _manage_single_position(self, position) -> None:
        """Manage individual position with time and profit controls - BUG FIXED."""
        try:
            # BUG FIX #2: Validate position object
            if not position or not hasattr(position, 'ticket'):
                return
            
            # Track position if new
            if position.ticket not in self.active_positions:
                self.active_positions[position.ticket] = {
                    'open_time': datetime.now(),
                    'symbol': getattr(position, 'symbol', 'UNKNOWN'),
                    'initial_volume': getattr(position, 'volume', 0),
                    'max_profit': 0.0,
                    'partial_closed': False
                }
            
            pos_info = self.active_positions[position.ticket]
            
            # BUG FIX #2: Safe profit calculation with None checks
            profit = getattr(position, 'profit', 0) or 0
            swap = getattr(position, 'swap', 0) or 0
            current_profit = profit + swap
            
            # Update max profit
            if current_profit > pos_info['max_profit']:
                pos_info['max_profit'] = current_profit
            
            # Time-based management (scalping = short holds)
            hold_time = (datetime.now() - pos_info['open_time']).total_seconds() / 60
            
            # Force close after 30 minutes
            if hold_time > 30:
                self._close_position(position, "Max hold time exceeded")
                return
            
            # Profit management with validation
            symbol = getattr(position, 'symbol', None)
            if not symbol:
                return
                
            symbol_info = mt5.symbol_info(symbol)
            if symbol_info:
                tick = mt5.symbol_info_tick(symbol)
                if tick:
                    point = getattr(symbol_info, 'point', 0.00001)
                    if point <= 0:
                        return
                    
                    # BUG FIX #2: Safe price calculations
                    position_type = getattr(position, 'type', None)
                    price_open = getattr(position, 'price_open', 0)
                    
                    if position_type == mt5.POSITION_TYPE_BUY and price_open > 0:
                        pip_profit = (tick.bid - price_open) / point
                    elif position_type == mt5.POSITION_TYPE_SELL and price_open > 0:
                        pip_profit = (price_open - tick.ask) / point
                    else:
                        return  # Invalid position data
                    
                    # Partial close at 15 pips profit
                    current_volume = getattr(position, 'volume', 0)
                    volume_min = getattr(symbol_info, 'volume_min', 0.01)
                    
                    if (pip_profit >= 15 and current_volume > volume_min * 1.5 
                        and not pos_info['partial_closed']):
                        partial_volume = current_volume * 0.5
                        if self._partial_close(position, partial_volume, "Partial profit taking"):
                            pos_info['partial_closed'] = True
            
        except Exception as e:
            self.logger.error(f"Single position management failed: {e}")
            # BUG FIX #2: Clean up corrupted position data
            if hasattr(position, 'ticket') and position.ticket in self.active_positions:
                del self.active_positions[position.ticket]
    
    def _close_position(self, position, reason: str) -> bool:
        """Close position completely."""
        try:
            tick = mt5.symbol_info_tick(position.symbol)
            if not tick:
                return False
            
            if position.type == mt5.POSITION_TYPE_BUY:
                price = tick.bid
                order_type = mt5.ORDER_TYPE_SELL
            else:
                price = tick.ask
                order_type = mt5.ORDER_TYPE_BUY
            
            request = {
                "action": mt5.TRADE_ACTION_DEAL,
                "symbol": position.symbol,
                "volume": position.volume,
                "type": order_type,
                "position": position.ticket,
                "price": price,
                "deviation": 3,
                "magic": 67890,
                "comment": f"Close: {reason}",
                "type_time": mt5.ORDER_TIME_GTC,
                "type_filling": mt5.ORDER_FILLING_IOC,
            }
            
            result = mt5.order_send(request)
            
            if result.retcode == mt5.TRADE_RETCODE_DONE:
                self.logger.info(f"Position closed: {position.symbol} - {reason}")
                self.active_positions.pop(position.ticket, None)
                return True
            else:
                self.logger.error(f"Failed to close position: {result.comment}")
                return False
                
