class IncrementalIndicators:
    """OPTIMIZATION: Incremental indicator calculation to save CPU."""
    
    def __init__(self):
        self.last_values = {}
        self.ema_multipliers = {}
    
    def update_ema_incremental(self, symbol: str, period: int, new_price: float, last_ema: Optional[float] = None) -> float:
        """Calculate EMA incrementally instead of full array."""
        key = f"{symbol}_{period}"
        
        if key not in self.ema_multipliers:
            self.ema_multipliers[key] = 2.0 / (period + 1.0)
        
        alpha = self.ema_multipliers[key]
        
        if last_ema is None:
            return new_price  # First value
        
        return alpha * new_price + (1 - alpha) * last_ema
    
    def update_rsi_incremental(self, symbol: str, period: int, price_change: float, 
                              last_avg_gain: float, last_avg_loss: float) -> tuple:
        """Update RSI incrementally."""
        alpha = 1.0 / period
        
        if price_change > 0:
            avg_gain = alpha * price_change + (1 - alpha) * last_avg_gain
            avg_loss = (1 - alpha) * last_avg_loss
        else:
            avg_gain = (1 - alpha) * last_avg_gain
            avg_loss = alpha * abs(price_change) + (1 - alpha) * last_avg_loss
        
        rs = avg_gain / (avg_loss + 1e-10)
        rsi = 100 - (100 / (1 + rs))
        
        return rsi, avg_gain, avg_loss

class VectorizedIndicators:
    """Optimized vectorized technical indicators with incremental updates."""
    
    def __init__(self):
        self.incremental = IncrementalIndicators()
        self.last_calculations = {}
    
    @staticmethod
    def ema_vectorized(values: np.ndarray, period: int) -> np.ndarray:
        """Vectorized EMA calculation - OPTIMIZED."""
        alpha = 2.0 / (period + 1.0)
        result = np.empty_like(values, dtype=float)
        result[0] = values[0]
        
        # FIX: Use numba-style loop optimization
        for i in range(1, len(values)):
            result[i] = alpha * values[i] + (1 - alpha) * result[i-1]
        
        return result
    
    @staticmethod
    def rsi_vectorized(prices: np.ndarray, period: int) -> np.ndarray:
        """Vectorized RSI - OPTIMIZED."""
        deltas = np.diff(prices)
        gains = np.where(deltas > 0, deltas, 0)
        losses = np.where(deltas < 0, -deltas, 0)
        
        # Pad with zeros
        gains = np.concatenate([[0], gains])
        losses = np.concatenate([[0], losses])
        
        # Use pandas for EWM (faster than manual)
        avg_gains = pd.Series(gains).ewm(span=period, adjust=False).mean().values
        avg_losses = pd.Series(losses).ewm(span=period, adjust=False).mean().values
        
        rs = avg_gains / np.where(avg_losses != 0, avg_losses, 1e-10)
        return 100 - (100 / (1 + rs))
    
