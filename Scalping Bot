    @staticmethod
    def _detect_engulfing_patterns_vectorized(df, open_p, high_p, low_p, close_p):
        """OPTIMIZED: Fully vectorized engulfing pattern detection."""
        body_size = np.abs(close_p - open_p)
        prev_body_size = np.roll(body_size, 1)
        
        # Vectorized conditions
        current_bullish = close_p > open_p
        current_bearish = close_p < open_p
        prev_bullish = np.roll(close_p, 1) > np.roll(open_p, 1)
        prev_bearish = np.roll(close_p, 1) < np.roll(open_p, 1)
        
        # Engulfing conditions
        bullish_engulfs = (close_p > np.roll(open_p, 1)) & (open_p < np.roll(close_p, 1))
        bearish_engulfs = (close_p < np.roll(open_p, 1)) & (open_p > np.roll(close_p, 1))
        
        # Size condition
        size_condition = body_size > prev_body_size * 1.2
        
        df['bullish_engulfing'] = current_bullish & prev_bearish & bullish_engulfs & size_condition
        df['bearish_engulfing'] = current_bearish & prev_bullish & bearish_engulfs & size_condition
        
        return df
    
    @staticmethod
    def _detect_pin_bars_vectorized(df, open_p, high_p, low_p, close_p):
        """OPTIMIZED: Vectorized pin bar detection."""
        body_size = np.abs(close_p - open_p)
        full_range = high_p - low_p
        upper_wick = high_p - np.maximum(open_p, close_p)
        lower_wick = np.minimum(open_p, close_p) - low_p
        
        # ATR for range validation
        atr_values = df['atr'].values if 'atr' in df.columns else np.full(len(df), 0.001)
        
        # Vectorized conditions
        long_lower_wick = lower_wick > body_size * 2
        small_upper_wick = upper_wick < body_size * 0.5
        small_body = body_size < full_range * 0.3
        significant_range = full_range > atr_values * 0.8
        
        long_upper_wick = upper_wick > body_size * 2
        small_lower_wick = lower_wick < body_size * 0.5
        
        df['bullish_pin_bar'] = long_lower_wick & small_upper_wick & small_body & significant_range
        df['bearish_pin_bar'] = long_upper_wick & small_lower_wick & small_body & significant_range
        
        return df
    
    @staticmethod
    def _detect_inside_outside_bars_vectorized(df, high_p, low_p):
        """OPTIMIZED: Vectorized inside/outside bar detection."""
        prev_high = np.roll(high_p, 1)
        prev_low = np.roll(low_p, 1)
        
        df['inside_bar'] = (high_p < prev_high) & (low_p > prev_low)
        df['outside_bar'] = (high_p > prev_high) & (low_p < prev_low)
        
        return df
    
    @staticmethod
    def _detect_hammer_shooting_star_vectorized(df, open_p, high_p, low_p, close_p):
        """OPTIMIZED: Vectorized hammer/shooting star detection."""
        body_size = np.abs(close_p - open_p)
        full_range = high_p - low_p
        upper_shadow = high_p - np.maximum(open_p, close_p)
        lower_shadow = np.minimum(open_p, close_p) - low_p
        
        atr_values = df.get('atr', pd.Series(0.001, index=df.index)).values
        
        # Hammer conditions
        bullish_close = close_p > open_p
        long_lower_shadow = lower_shadow > body_size * 2
        small_upper_shadow = upper_shadow <= body_size * 0.3
        small_body = body_size < full_range * 0.4
        significant_range = full_range > atr_values * 0.7
        
        # Shooting star conditions  
        bearish_close = close_p < open_p
        long_upper_shadow = upper_shadow > body_size * 2
        small_lower_shadow = lower_shadow <= body_size * 0.3
        
        df['hammer_enhanced'] = bullish_close & long_lower_shadow & small_upper_shadow & small_body & significant_range
        df['shooting_star_enhanced'] = bearish_close & long_upper_shadow & small_lower_shadow & small_body & significant_range
        
        return df
    
    @staticmethod
    def _detect_key_dojis_vectorized(df, open_p, high_p, low_p, close_p):
