    def __del__(self):
        """FIX: Cleanup thread pool."""
        if hasattr(self, 'executor'):
            self.executor.shutdown(wait=False)
        
    def _get_smart_ttl(self, timeframe: int) -> int:
        """OPTIMIZATION: Smart TTL based on timeframe."""
        if timeframe <= mt5.TIMEFRAME_M1:
            return 3  # 3 seconds for M1
        elif timeframe <= mt5.TIMEFRAME_M5:
            return 15  # 15 seconds for M5
        elif timeframe <= mt5.TIMEFRAME_M15:
            return 45  # 45 seconds for M15
        else:
            return 120  # 2 minutes for higher timeframes
    
    def get_rates(self, symbol: str, timeframe: int, count: int, is_update: bool = False) -> Optional[pd.DataFrame]:
        """Get rates with smart caching and incremental updates - BUG FIXED."""
        cache_key = f"{symbol}_{timeframe}_{count}"
        
        # Check cache first
        cached = self.cache.get(cache_key)
        if cached is not None and not is_update:
            return cached.copy()
            
        start_time = time.perf_counter()
        try:
            # BUG FIX: Validate inputs
            if not symbol or count <= 0:
                return None
                
            rates = mt5.copy_rates_from_pos(symbol, timeframe, 0, count)
            if rates is None or len(rates) == 0:
                return None
                
            df = pd.DataFrame(rates)
            
            # BUG FIX: Ensure required columns exist
            required_cols = ['time', 'open', 'high', 'low', 'close', 'tick_volume']
            for col in required_cols:
                if col not in df.columns:
                    self.logger.error(f"Missing required column {col} in {symbol} data")
                    return None
            
            # BUG FIX: Safe datetime conversion
            try:
                df['time'] = pd.to_datetime(df['time'], unit='s', errors='coerce')
            except Exception:
                df['time'] = pd.to_datetime(df['time'], errors='coerce')
            
            # BUG FIX: Remove any invalid timestamps
            df = df.dropna(subset=['time'])
            if df.empty:
                return None
            
            # Data validation with safer fillna
            if df.isnull().any().any():
                df = df.fillna(method='ffill').fillna(method='bfill')
            
            # BUG FIX: Only calculate indicators if we have enough data
            if len(df) >= 50:
                df = self.indicators.calculate_all_optimized(df, symbol, is_update)
            
            # Smart TTL caching with validation
            smart_ttl = self._get_smart_ttl(timeframe)
            if smart_ttl > 0:  # BUG FIX: Ensure positive TTL
                self.cache.set(cache_key, df, smart_ttl)
            
            duration = time.perf_counter() - start_time
            self.logger.time_operation('data_fetch', duration)
            
            return df
            
        except Exception as e:
            self.logger.error(f"Data fetch failed for {symbol}: {e}")
            return None
            
    def get_multi_timeframe_data(self, symbol: str, timeframes: Dict[str, int]) -> Dict[str, pd.DataFrame]:
        """MIRACLE FIX: Single fetch + distribute instead of multiple API calls - BUG FIXED."""
        start_time = time.perf_counter()
        
        # BUG FIX: Validate inputs
        if not symbol or not timeframes:
            return {'trend': pd.DataFrame(), 'momentum': pd.DataFrame(), 'entry': pd.DataFrame()}
        
        try:
            # MIRACLE FIX 1: Check if we already have fresh data for this symbol
            current_time = time.time()
            cache_key = f"shared_{symbol}"
            
            if (cache_key in self.shared_data_cache and 
                current_time - self.last_fetch_time.get(symbol, 0) < 2):  # 2 second freshness
                # Reuse existing data instead of new API calls
                cached_data = self.shared_data_cache[cache_key]
                self.logger.time_operation('multi_timeframe_fetch', time.perf_counter() - start_time)
                return cached_data
            
            # Single large fetch instead of multiple small ones
            max_count = max([100, 80, 60])  # Get enough for all timeframes
            base_data = self.get_rates(symbol, mt5.TIMEFRAME_M1, max_count, False)
            
            if base_data is None or base_data.empty:
                # BUG FIX: Return proper structure on failure
                empty_result = {'trend': pd.DataFrame(), 'momentum': pd.DataFrame(), 'entry': pd.DataFrame()}
                return empty_result
            
            # MIRACLE FIX: Resample from single dataset instead of multiple API calls
            results = {}
            counts = {'trend': 100, 'momentum': 80, 'entry': 60}
            
            for tf_name, tf_value in timeframes.items():
                try:
                    count = counts.get(tf_name, 50)
                    
                    # BUG FIX: Validate timeframe value
                    if tf_value is None or tf_value <= 0:
                        results[tf_name] = pd.DataFrame()
                        continue
                    
                    # Resample M1 data to higher timeframes instead of new API call
                    if tf_value == mt5.TIMEFRAME_M1:
                        results[tf_name] = base_data.tail(count).copy()
                    elif tf_value == mt5.TIMEFRAME_M5:
                        # BUG FIX: Ensure we have enough data for resampling
                        if len(base_data) >= 5:
                            resampled = self._resample_data(base_data, '5T')
                            if not resampled.empty:
                                results[tf_name] = self.indicators.calculate_all_optimized(resampled.tail(count//5), symbol, False)
                            else:
                                results[tf_name] = pd.DataFrame()
                        else:
                            results[tf_name] = pd.DataFrame()
                    elif tf_value == mt5.TIMEFRAME_M15:
                        # BUG FIX: Ensure we have enough data for resampling
                        if len(base_data) >= 15:
                            resampled = self._resample_data(base_data, '15T')
                            if not resampled.empty:
                                results[tf_name] = self.indicators.calculate_all_optimized(resampled.tail(count//15), symbol, False)
                            else:
                                results[tf_name] = pd.DataFrame()
                        else:
                            results[tf_name] = pd.DataFrame()
                    else:
                        # Fallback to API call for other timeframes
                        try:
                            data = self.get_rates(symbol, tf_value, count)
                            results[tf_name] = data if data is not None else pd.DataFrame()
                        except Exception as e:
                            self.logger.error(f"Fallback API call failed for {tf_name}: {e}")
                            results[tf_name] = pd.DataFrame()
                        
                except Exception as e:
                    self.logger.error(f"Failed to process {tf_name} for {symbol}: {e}")
                    results[tf_name] = pd.DataFrame()
            
            # BUG FIX: Ensure all expected keys exist
            for tf_name in ['trend', 'momentum', 'entry']:
                if tf_name not in results:
                    results[tf_name] = pd.DataFrame()
            
            # Cache the results
            self.shared_data_cache[cache_key] = results
            self.last_fetch_time[symbol] = current_time
            
            duration = time.perf_counter() - start_time
            self.logger.time_operation('multi_timeframe_fetch', duration)
            
            return results
            
        except Exception as e:
            self.logger.error(f"Multi-timeframe data fetch failed for {symbol}: {e}")
            # BUG FIX: Return proper structure on critical error
            return {'trend': pd.DataFrame(), 'momentum': pd.DataFrame(), 'entry': pd.DataFrame()}
    
    def _resample_data(self, df: pd.DataFrame, freq: str) -> pd.DataFrame:
        """MIRACLE FIX: Fast resampling helper with BUG FIXES."""
        if df.empty or len(df) < 2:  # BUG FIX: Need at least 2 rows
            return df
            
        try:
            df_copy = df.copy()
            
            # BUG FIX: Ensure time column exists and is datetime
            if 'time' not in df_copy.columns:
                return df_copy
                
            if not pd.api.types.is_datetime64_any_dtype(df_copy['time']):
                df_copy['time'] = pd.to_datetime(df_copy['time'], errors='coerce')
            
            # BUG FIX: Remove any NaT values
            df_copy = df_copy.dropna(subset=['time'])
            if df_copy.empty:
                return pd.DataFrame()
            
            df_copy.set_index('time', inplace=True)
            
            # BUG FIX: Only resample columns that exist
            agg_dict = {}
            if 'open' in df_copy.columns:
                agg_dict['open'] = 'first'
            if 'high' in df_copy.columns:
                agg_dict['high'] = 'max'
            if 'low' in df_copy.columns:
                agg_dict['low'] = 'min'
            if 'close' in df_copy.columns:
                agg_dict['close'] = 'last'
            if 'tick_volume' in df_copy.columns:
                agg_dict['tick_volume'] = 'sum'
            if 'spread' in df_copy.columns:
                agg_dict['spread'] = 'mean'
            if 'real_volume' in df_copy.columns:
                agg_dict['real_volume'] = 'sum'
            
            if not agg_dict:  # BUG FIX: No valid columns to resample
                return pd.DataFrame()
            
            resampled = df_copy.resample(freq).agg(agg_dict).dropna()
            resampled.reset_index(inplace=True)
            return resampled
            
        except Exception as e:
            # BUG FIX: Return empty DataFrame on any resampling error
            return pd.DataFrame()

