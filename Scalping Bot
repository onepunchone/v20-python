            all_symbols = mt5.symbols_get()
            if not all_symbols:
                raise Exception("No symbols available")
            
            # Filter forex symbols
            forex_symbols = [
                symbol for symbol in all_symbols 
                if any(pair in symbol.name for pair in ['EUR', 'USD', 'GBP', 'JPY', 'CHF', 'CAD', 'AUD'])
            ]
            
            # Apply configuration filters
            filtered_symbols = []
            config = self.config['symbol_discovery']
            
            for symbol in forex_symbols:
                if not mt5.symbol_select(symbol.name, True):
                    continue
                
                info = mt5.symbol_info(symbol.name)
                if not info:
                    continue
                
                # Apply spread filter
                tick = mt5.symbol_info_tick(symbol.name)
                if tick:
                    spread_pips = (tick.ask - tick.bid) / info.point
                    if spread_pips > config['max_spread_pips']:
                        continue
                
                # Check if it's a major or preferred symbol
                is_major = any(pair in symbol.name for pair in ['EURUSD', 'GBPUSD', 'USDJPY', 'USDCHF'])
                is_preferred = symbol.name in config['preferred_symbols']
                
                if (config['include_majors'] and is_major) or is_preferred:
                    filtered_symbols.append(symbol.name)
            
            self.trading_symbols = filtered_symbols[:6]  # Limit for performance
            
            self.logger.info(f"Auto-discovered {len(self.trading_symbols)} symbols: {', '.join(self.trading_symbols)}")
            
        except Exception as e:
