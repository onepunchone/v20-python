    def _detect_regime(self, df: pd.DataFrame) -> Dict[str, Any]:
        """Detect market regime using EMA alignment and ATR."""
        if df.empty or len(df) < 20:
            return {'regime': 'unknown', 'volatility': 'normal', 'strength': 0, 'current_atr': 0.0020}
        
        try:
            current = df.iloc[-1]
            
            # EMA alignment for trend strength
            if all(col in current.index for col in ['ema8', 'ema21', 'ema50']):
                ema_aligned = (current['ema8'] > current['ema21'] > current['ema50']) or \
                             (current['ema8'] < current['ema21'] < current['ema50'])
                trend_strength = 30 if ema_aligned else 20
            else:
                trend_strength = 25
            
            # Volatility from ATR
            current_atr = current.get('atr', 0.0020)
            if 'atr' in current.index:
                avg_atr = df['atr'].tail(20).mean()
                volatility_ratio = current_atr / avg_atr if avg_atr > 0 else 1
                
