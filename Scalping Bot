    @staticmethod
    def _detect_double_patterns_fast(df, high_p, low_p):
        """FAST: Simplified double top/bottom detection."""
        window = 10
        
        # Simple approach: look for similar highs/lows within window
        double_top = np.zeros(len(df), dtype=bool)
        double_bottom = np.zeros(len(df), dtype=bool)
        
        for i in range(window, len(df)):
            recent_highs = high_p[i-window:i]
            recent_lows = low_p[i-window:i]
            
            # Find two highest/lowest points
            if len(recent_highs) >= 2:
                sorted_highs = np.sort(recent_highs)[-2:]
                if abs(sorted_highs[1] - sorted_highs[0]) / sorted_highs[1] < 0.01:
                    double_top[i] = True
                    
                sorted_lows = np.sort(recent_lows)[:2]
                if abs(sorted_lows[1] - sorted_lows[0]) / sorted_lows[0] < 0.01:
                    double_bottom[i] = True
        
        df['double_top'] = double_top
        df['double_bottom'] = double_bottom
        return df
    
    @staticmethod
    def _detect_support_resistance_breaks_fast(df, high_p, low_p, close_p):
        """FAST: Simplified support/resistance break detection."""
        window = 20
        
        support_break = np.zeros(len(df), dtype=bool)
        resistance_break = np.zeros(len(df), dtype=bool)
        
        for i in range(window, len(df)):
            recent_lows = low_p[i-window:i-2]
            recent_highs = high_p[i-window:i-2]
            
            support_level = np.percentile(recent_lows, 20)
            resistance_level = np.percentile(recent_highs, 80)
            
            if close_p[i] < support_level * 0.998:
                support_break[i] = True
            if close_p[i] > resistance_level * 1.002:
                resistance_break[i] = True
        
        df['support_break'] = support_break
        df['resistance_break'] = resistance_break
        return df
    
