class RiskManager:
    """Comprehensive risk management with performance analytics."""
    
    def __init__(self, config: Dict[str, Any], logger: EliteLogger):
        self.config = config
        self.logger = logger
        # FIX: Memory leak - limit all deque sizes
        self.performance = {
            'total_trades': 0, 'winning_trades': 0, 'losing_trades': 0,
            'total_profit': 0.0, 'total_loss': 0.0, 'max_drawdown': 0.0,
            'current_drawdown': 0.0, 'peak_balance': 0.0,
            'consecutive_wins': 0, 'consecutive_losses': 0,
            'sharpe_ratio': 0.0, 'sortino_ratio': 0.0, 'calmar_ratio': 0.0,
            'trade_history': deque(maxlen=500)  # FIX: Ensure maxlen
        }
        
    def calculate_position_size(self, signal_strength: float, confidence: float, 
                              symbol: str, atr: float, account_balance: float) -> float:
        """Advanced position sizing with multiple factors - BUG FIXED."""
        try:
            # BUG FIX #1: Validate all inputs
            if not symbol or atr <= 0 or account_balance <= 0:
                return self.config.get('min_position_size', 0.01)
            
            # Base risk
            base_risk_percent = self.config.get('base_risk_percent', 2.5)
            base_risk = account_balance * (base_risk_percent / 100)
            
            # Account size adjustment (small account optimization)
            if account_balance < 200:
                size_multiplier = 0.5
            elif account_balance < 500:
                size_multiplier = 0.7
            elif account_balance < 1000:
                size_multiplier = 0.9
            else:
                size_multiplier = 1.0
            
            base_risk *= size_multiplier
            
            # Anti-martingale
            if self.config.get('anti_martingale_enabled', True):
                consecutive_losses = self.performance.get('consecutive_losses', 0)
                if consecutive_losses > 0:
                    martingale_factor = max(0.5, 0.9 ** consecutive_losses)
                    base_risk *= martingale_factor
            
            # Confidence scaling
            if self.config.get('confidence_scaling_enabled', True):
                confidence_factor = max(0.3, min(1.0, confidence / 100.0))  # BUG FIX: Clamp confidence
                base_risk *= confidence_factor
            
            # Convert to position size
            symbol_info = mt5.symbol_info(symbol)
            if not symbol_info or atr <= 0:
                return self.config.get('min_position_size', 0.01)
            
            stop_distance = atr * 2.0
            stop_pips = stop_distance / max(symbol_info.point, 0.00001)  # BUG FIX: Prevent division by zero
            tick_value = getattr(symbol_info, 'trade_tick_value', 0)
            
            if tick_value <= 0:
                return self.config.get('min_position_size', 0.01)
            
            position_size = base_risk / (stop_pips * tick_value)
            
            # Apply limits with validation
            min_size = max(getattr(symbol_info, 'volume_min', 0.01), self.config.get('min_position_size', 0.01))
            max_size = min(getattr(symbol_info, 'volume_max', 100), self.config.get('max_position_size', 0.5))
            
            position_size = max(position_size, min_size)
            position_size = min(position_size, max_size)
            
            # Round to valid step
            volume_step = getattr(symbol_info, 'volume_step', 0.01)
            if volume_step > 0:
                position_size = round(position_size / volume_step) * volume_step
            
            return max(position_size, min_size)
            
        except Exception as e:
            self.logger.error(f"Position sizing failed: {e}")
            return self.config.get('min_position_size', 0.01)
    
    def validate_trade(self, symbol: str, account_info) -> Dict[str, Any]:
        """Comprehensive trade validation."""
        validation = {'approved': True, 'reasons': []}
        
        try:
            # Daily trade limit
            if self.performance['total_trades'] >= self.config['max_daily_trades']:
                validation['approved'] = False
                validation['reasons'].append('Daily trade limit exceeded')
            
            # Consecutive loss limit
            if self.performance['consecutive_losses'] >= self.config['max_consecutive_losses']:
                validation['approved'] = False
                validation['reasons'].append('Max consecutive losses reached')
            
            # Drawdown limit
            current_drawdown = self._calculate_drawdown(account_info.equity)
            if current_drawdown > self.config['max_drawdown_percent']:
                validation['approved'] = False
                validation['reasons'].append(f'Drawdown limit exceeded: {current_drawdown:.1f}%')
            
            # Margin check
            if account_info.margin_level < 200 and account_info.margin_level > 0:
                validation['approved'] = False
                validation['reasons'].append('Insufficient margin')
            
            return validation
            
        except Exception as e:
            self.logger.error(f"Trade validation failed: {e}")
            return {'approved': False, 'reasons': ['Validation error']}
    
    def _calculate_drawdown(self, current_equity: float) -> float:
        """Calculate current drawdown percentage."""
        if self.performance['peak_balance'] == 0:
            self.performance['peak_balance'] = current_equity
            return 0.0
        
        if current_equity > self.performance['peak_balance']:
            self.performance['peak_balance'] = current_equity
            self.performance['current_drawdown'] = 0.0
        else:
            self.performance['current_drawdown'] = (
                (self.performance['peak_balance'] - current_equity) / 
                self.performance['peak_balance'] * 100
            )
        
        return self.performance['current_drawdown']
    
    def update_performance(self, trade_result: Dict) -> None:
        """Update performance metrics including Sharpe/Sortino/Calmar ratios."""
        profit = trade_result['profit']
        
        self.performance['total_trades'] += 1
        
        if profit > 0:
            self.performance['winning_trades'] += 1
            self.performance['total_profit'] += profit
            self.performance['consecutive_wins'] += 1
            self.performance['consecutive_losses'] = 0
        else:
            self.performance['losing_trades'] += 1
            self.performance['total_loss'] += abs(profit)
            self.performance['consecutive_losses'] += 1
            self.performance['consecutive_wins'] = 0
        
        # Add to trade history
        self.performance['trade_history'].append({
            'timestamp': datetime.now(),
            'profit': profit,
            'symbol': trade_result.get('symbol', ''),
            'hold_time': trade_result.get('hold_time', 0)
        })
        
        # Calculate advanced ratios
        self._calculate_performance_ratios()
    
    def _calculate_performance_ratios(self) -> None:
        """Calculate Sharpe, Sortino, and Calmar ratios."""
        if len(self.performance['trade_history']) < 10:
            return
        
        returns = [trade['profit'] for trade in list(self.performance['trade_history'])[-100:]]
        returns_array = np.array(returns)
        
        if len(returns_array) == 0:
            return
        
        mean_return = np.mean(returns_array)
        std_return = np.std(returns_array)
        
        # Sharpe Ratio
        if std_return > 0:
            self.performance['sharpe_ratio'] = mean_return / std_return
        
        # Sortino Ratio (downside deviation only)
        negative_returns = returns_array[returns_array < 0]
        if len(negative_returns) > 0:
            downside_deviation = np.std(negative_returns)
            if downside_deviation > 0:
                self.performance['sortino_ratio'] = mean_return / downside_deviation
        
        # Calmar Ratio
        if self.performance['max_drawdown'] > 0:
            annual_return = mean_return * 252  # Assuming daily returns
            self.performance['calmar_ratio'] = annual_return / self.performance['max_drawdown']

