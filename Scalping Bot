    def _assess_market_activity(self) -> str:
        """2-MINUTE EFFICIENCY: Assess current market activity level."""
        current_time = time.time()
        
        # Only check every 30 seconds
        if current_time - self.last_activity_check < 30:
            return self.market_activity_level
        
        try:
            total_movement = 0
            total_volume = 0
            valid_symbols = 0
            
            # Quick bulk tick fetch for all symbols
            bulk_ticks = self._get_bulk_ticks()
            
            for symbol in self.trading_symbols[:3]:  # Check top 3 symbols only
                if symbol not in bulk_ticks:
                    continue
                    
                tick = bulk_ticks[symbol]
                if not tick:
                    continue
                
                # Calculate price movement
                current_price = (tick.ask + tick.bid) / 2
                
                if symbol in self.symbol_price_history:
                    prev_price = self.symbol_price_history[symbol]['price']
                    time_diff = current_time - self.symbol_price_history[symbol]['time']
                    
                    if time_diff > 0:
                        price_change = abs(current_price - prev_price) / prev_price
                        movement_rate = price_change / (time_diff / 60)  # Per minute
                        total_movement += movement_rate
                        
                        # Volume approximation
                        volume_estimate = getattr(tick, 'volume', 1) or 1
                        total_volume += volume_estimate
                        valid_symbols += 1
                
                # Update price history
                self.symbol_price_history[symbol] = {
                    'price': current_price,
                    'time': current_time
                }
            
            if valid_symbols > 0:
                avg_movement = total_movement / valid_symbols
                avg_volume = total_volume / valid_symbols
                
                # Determine activity level
                if avg_movement > 0.0005 or avg_volume > 100:  # High activity
                    self.market_activity_level = 'volatile'
                elif avg_movement > 0.0002 or avg_volume > 50:  # Medium activity
                    self.market_activity_level = 'active'
                elif avg_movement > 0.0001:  # Low activity
                    self.market_activity_level = 'normal'
                else:  # Very low activity
                    self.market_activity_level = 'quiet'
            
            self.last_activity_check = current_time
            return self.market_activity_level
            
        except Exception as e:
            self.logger.error(f"Market activity assessment failed: {e}")
            return 'normal'  # Safe default
    
